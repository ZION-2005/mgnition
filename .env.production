POSTGRES_DB=mgnition
POSTGRES_USER=mgnition
POSTGRES_PASSWORD=replace_with_strong_password

# Public URL used by backend in emails
FRONTEND_URL=https://your-domain.com

# Frontend container port mapping
WEB_PORT=80

# CORS (keep * when frontend and backend are same origin through /api proxy)
ALLOWED_ORIGINS=*

# Optional: enables map rendering in frontend
VITE_GOOGLE_MAPS_API_KEY=

# Optional: email sending for password reset and booking approvals
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
